{
  "name": "obsidian-tube-scribe",
  "version": "0.1.0",
  "description": "YouTube metadata pipeline plugin for Obsidian, powered by Claude AI",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": ["obsidian", "youtube", "metadata", "claude", "ai"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^18.0.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.6.0",
    "typescript": "5.5.4"
  }
}
